# ────────────────────────────────────────────
# CortexCRM — Environment Variable Reference
# Copy this file and fill in real values.
# NEVER commit files with real secrets.
# ────────────────────────────────────────────

# Claude / Anthropic AI key (optional — AI endpoints return 503 without it)
# Get yours at: https://console.anthropic.com
# This maps to claude.api.key in application.yml
CLAUDE_API_KEY=your-claude-api-key-here

# JWT signing secret — must be at least 64 hex characters
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# PostgreSQL credentials (must match docker-compose.yml)
DB_PASSWORD=your-db-password-here

# Redis password (leave empty if no Redis auth configured)
REDIS_PASSWORD=your-redis-password-here
